{
  "name": "taskflow-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "build": "node --check src/index.js",
    "migrate": "sequelize-cli db:migrate --config src/config/config.cjs",
    "seed": "sequelize-cli db:seed:all --config src/config/config.cjs",
    "seed:undo": "sequelize-cli db:seed:undo:all --config src/config/config.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.5",
    "sequelize": "^6.37.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  }
}
